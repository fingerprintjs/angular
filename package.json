{
  "name": "fingerprintjs-pro-angular-workspace",
  "version": "0.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepare": "husky install",
    "ng": "ng",
    "start": "pnpm --filter demo-angular15 start",
    "build": "ng build fingerprintjs-pro-angular && ./bin/copy_assets.sh",
    "watch:library": "ng build fingerprintjs-pro-angular --watch",
    "generate:version": "node bin/generate-version.js",
    "lint": "eslint --ext .js,.mjs,.ts --ignore-path .gitignore --max-warnings 0 .",
    "lint:fix": "eslint --ext .js,.mjs,.ts --ignore-path .gitignore --max-warnings 0 --fix .",
    "test:dts": "tsc -p tsconfig.test-dts.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:matrix": "pnpm generate:version && tsx bin/test-matrix.ts",
    "docs": "typedoc projects/fingerprintjs-pro-angular/src/public-api.ts --tsconfig projects/fingerprintjs-pro-angular/tsconfig.lib.json --out docs",
    "changeset:publish": "HUSKY=0 pnpm build && changeset publish",
    "changeset:version": "changeset version"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.10",
    "@angular-eslint/schematics": "^15.2.1",
    "@angular/cli": "^15.2.10",
    "@angular/compiler-cli": "^15.2.10",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^17.2.0",
    "@fingerprint/agent": "^4.1.6",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.0.2",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.1.0",
    "@fingerprintjs/eslint-config-dx-team": "^0.1.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "comment-json": "^5.0.0",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.2",
    "jasmine-core": "~4.0.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.3",
    "lint-staged": "^13.0.3",
    "ng-packagr": "^15.2.2",
    "prettier": "^3.2.4",
    "tsx": "^4.22.4",
    "typedoc": "^0.24.8",
    "typescript": "~4.9.5"
  },
  "lint-staged": {
    "*.ts": "pnpm lint:fix",
    "*.tsx": "pnpm lint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "workspaces": [
    "projects/*"
  ],
  "pnpm": {
    "overrides": {
      "rxjs": "~7.8.0"
    }
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
